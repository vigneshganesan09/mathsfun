   "translator": "Esther Beugeling-Ford",
   "readerUrl": "https://global-asp.github.io/storybooks-swahili/stories/nl/0087/"
  },
  "pages": [
   {
    "nl": "Ik hou van lezen.",
    "en": "I like to read.",
    "image": "books/0087/01.jpg"
   },
   {
    "nl": "Aan wie kan ik voorlezen?",
    "en": "Who can I read to?",
    "image": "books/0087/02.jpg"
   },
   {
    "nl": "Mijn zusje slaapt.",
    "en": "My sister is asleep.",
    "image": "books/0087/03.jpg"
   },
   {
    "nl": "Aan wie kan ik voorlezen?",
    "en": "Who can I read to?",
    "image": "books/0087/04.jpg"
   },
   {
    "nl": "Mijn moeder en mijn oma zijn bezig.",
    "en": "My mother and grandmother are busy.",
    "image": "books/0087/05.jpg"
   },
   {
    "nl": "Aan wie kan ik voorlezen?",
    "en": "Who can I read to?",
    "image": "books/0087/06.jpg"
   },
   {
    "nl": "Mijn vader en mijn opa zijn bezig.",
    "en": "My father and grandfather are busy.",
    "image": "books/0087/07.jpg"
   },
   {
    "nl": "Aan wie kan ik voorlezen? Ik kan aan mezelf voorlezen !",
    "en": "Who can I read to? I can read to myself!",
    "image": "books/0087/08.jpg"
   }
  ],
