   {
    "nl": "Kijk naar de dieren.",
    "en": "Look at the animals.",
    "image": "books/0002/01.jpg"
   },
   {
    "nl": "De koe zegt, “Boe”.",
    "en": "The cow says, “Moo.”",
    "image": "books/0002/02.jpg"
   },
   {
    "nl": "De geit zegt, “Mèèè”.",
    "en": "The goat says, “Meh, meh.”",
    "image": "books/0002/03.jpg"
   },
   {
    "nl": "Het paard zegt, “Hihi”.",
    "en": "The horse says, “Neigh.”",
    "image": "books/0002/04.jpg"
   },
   {
    "nl": "Het varken zegt, “Knor”.",
    "en": "The pig says, “Grunt.”",
    "image": "books/0002/05.jpg"
   },
   {
    "nl": "De kip zegt, “Tok”.",
    "en": "The chicken says, “Cluck.”",
    "image": "books/0002/06.jpg"
   },
   {
    "nl": "De hond zegt, “Woef”.",
    "en": "The dog says, “Woof.”",
    "image": "books/0002/07.jpg"
   },
   {
    "nl": "De boer zegt, “Ssst!”",
    "en": "The farmer says, “Shhh!”",
    "image": "books/0002/08.jpg"
   }
  ],
