  },
  "pages": [
   {
    "nl": "Zijn schoffel was te kort.",
    "en": "His hoe was too short.",
    "image": "books/0001/01.jpg"
   },
   {
    "nl": "Zijn deurpost was te laag.",
    "en": "His doorway was too low.",
    "image": "books/0001/02.jpg"
   },
   {
    "nl": "Zijn bed was te kort.",
    "en": "His bed was too short.",
    "image": "books/0001/03.jpg"
   },
   {
    "nl": "Zijn fiets was te klein.",
    "en": "His bicycle was too short.",
    "image": "books/0001/04.jpg"
   },
   {
    "nl": "Deze man was te lang!",
    "en": "This man was too tall!",
    "image": "books/0001/05.jpg"
   },
   {
    "nl": "Hij maakte een hele lange schoffelsteel.",
    "en": "He made a very long hoe handle.",
    "image": "books/0001/06.jpg"
   },
   {
    "nl": "Hij maakte hele hoge deurposten.",
    "en": "He made very high door frames.",
    "image": "books/0001/07.jpg"
   },
   {
    "nl": "Hij maakte een heel lang bed.",
    "en": "He made a very long bed.",
    "image": "books/0001/08.jpg"
   },
   {
    "nl": "Hij kocht een hele grote fiets.",
    "en": "He bought a very high bicycle.",
    "image": "books/0001/09.jpg"
   },
   {
    "nl": "Hij zat op een hele hoge stoel. Hij at met een hele lange vork.",
    "en": "He sat on a very high chair. He ate with a very long fork.",
    "image": "books/0001/10.jpg"
   },
   {
    "nl": "Hij verliet zijn huis en ging in een groot bos wonen. Hij leefde nog vele jaren.",
    "en": "He left his house and lived in a big forest. He lived for many years.",
    "image": "books/0001/11.jpg"
   }
  ],
