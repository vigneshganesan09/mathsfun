 {
  "id": "asp-0327",
  "level": "g3",
  "title": {
   "nl": "Dieren tellen",
   "en": "Counting animals"
  },
  "cover": {},
  "coverImage": "books/0327/cover.jpg",
  "online": {
   "sourceTitle": "Counting animals",
   "sourceUrl": "https://africanstorybook.org/reader.php?id=9671",
   "licence": "Creative Commons Attribution 3.0 International License",
   "licenceUrl": "https://creativecommons.org/licenses/by/3.0/",
   "author": "Zanele Buthelezi, Thembani Dladla, Clare Verbeek",
   "illustrator": "Rob Owen",
   "translator": "Esther Beugeling-Ford",
   "readerUrl": "https://global-asp.github.io/storybooks-swahili/stories/nl/0327/"
  },
  "pages": [
   {
    "nl": "Een olifant gaat water drinken.",
    "en": "One elephant is going to drink water.",
    "image": "books/0327/01.jpg"
   },
   {
    "nl": "Twee giraffen gaan water drinken.",
    "en": "Two giraffes are going to drink water.",
    "image": "books/0327/02.jpg"
   },
   {
    "nl": "Drie buffels en vier vogels gaan ook water drinken.",
    "en": "Three buffaloes and four birds are also going to drink water.",
    "image": "books/0327/03.jpg"
   },
   {
    "nl": "Vijf impala’s en zes wrattenzwijnen lopen naar het water.",
    "en": "Five impalas and six warthogs are walking to the water.",
    "image": "books/0327/04.jpg"
   },
   {
    "nl": "Zeven zebra’s rennen naar het water.",
    "en": "Seven zebras are running to the water.",
    "image": "books/0327/05.jpg"
   },
   {
    "nl": "Acht kikkers en negen vissen zwemmen in het water.",
    "en": "Eight frogs and nine fish are swimming in the water.",
    "image": "books/0327/06.jpg"
   },
   {
    "nl": "Een leeuw brult. Hij wil ook drinken. Wie is er bang voor de leeuw?",
    "en": "One lion roars. He also wants to drink. Who is afraid of the lion?",
    "image": "books/0327/07.jpg"
   },
   {
    "nl": "Een olifant drinkt water met de leeuw.",
    "en": "One elephant is drinking water with the lion.",
    "image": "books/0327/08.jpg"
   }
  ],
  "avi": "AVI M3",
  "shelf": "eerste",
  "colour": "#ff7a1a"
