 {
  "id": "asp-0030",
  "level": "g3",
  "title": {
   "nl": "Gevoelens",
   "en": "Feelings"
  },
  "cover": {},
  "coverImage": "books/0030/cover.jpg",
  "online": {
   "sourceTitle": "Feelings",
   "sourceUrl": "https://africanstorybook.org/reader.php?id=2884",
   "licence": "Creative Commons Attribution-NonCommercial 3.0 International License",
   "licenceUrl": "https://creativecommons.org/licenses/by-nc/3.0/",
   "author": "Clare Verbeek, Thembani Dladla, Zanele Buthelezi",
   "illustrator": "Kathy Arbuckle, Ingrid Schechter",
   "translator": "Esther Beugeling-Ford",
   "readerUrl": "https://global-asp.github.io/storybooks-swahili/stories/nl/0030/"
  },
  "pages": [
   {
    "nl": "Mijn hart voelt veel dingen.",
    "en": "My heart feels a lot of things.",
    "image": "books/0030/01.jpg"
   },
   {
    "nl": "Ik voel me blij als mijn oma ons ‘s avonds verhaaltjes vertelt.",
    "en": "I feel happy when my granny tells us stories in the evening.",
    "image": "books/0030/02.jpg"
   },
   {
    "nl": "Ik voel me grappig als ik met mijn vriendinnetje speel.",
    "en": "I feel silly when I play with my friend.",
    "image": "books/0030/03.jpg"
   },
   {
    "nl": "Ik voel me verdrietig als mijn vader zegt dat hij geen geld heeft.",
    "en": "I feel bad when my dad says he does not have money.",
    "image": "books/0030/04.jpg"
   },
   {
    "nl": "Ik voel me geliefd als mijn moeder mij een knuffel geeft.",
    "en": "I feel loved when my mom gives me a hug.",
    "image": "books/0030/05.jpg"
   }
  ],
  "avi": "AVI E3",
  "shelf": "eerste",
  "colour": "#16825a"
