  "title": {
   "nl": "Een hele lange man",
   "en": "A very tall man"
  },
  "cover": {},
  "coverImage": "books/0001/cover.jpg",
  "online": {
   "sourceTitle": "A very tall man",
   "sourceUrl": "https://africanstorybook.org/reader.php?id=918",
