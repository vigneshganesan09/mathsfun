 {
  "id": "asp-0156",
  "level": "g3",
  "title": {
   "nl": "De krokodil die honger had",
   "en": "The hungry crocodile"
  },
  "cover": {},
  "coverImage": "books/0156/cover.jpg",
  "online": {
   "sourceTitle": "The hungry crocodile",
   "sourceUrl": "https://africanstorybook.org/reader.php?id=7043",
   "licence": "Creative Commons Attribution 3.0 International License",
   "licenceUrl": "https://creativecommons.org/licenses/by/3.0/",
   "author": "Christian G.",
   "illustrator": "Wiehan de Jager",
   "translator": "Sacha Kalseth",
   "readerUrl": "https://global-asp.github.io/storybooks-swahili/stories/nl/0156/"
  },
  "pages": [
   {
    "nl": "Er was eens een krokodil die erg honger had.",
    "en": "Once there was a very hungry crocodile.",
    "image": "books/0156/01.jpg"
   },
   {
    "nl": "Hij zocht langzaam en zachtjes naar voedsel. En toen…",
    "en": "He searched for food slowly and quietly. And then…",
    "image": "books/0156/02.jpg"
   },
   {
    "nl": "POW!!! De krokodil slaat toe!",
    "en": "POW!!! The crocodile strikes!",
    "image": "books/0156/03.jpg"
   },
   {
    "nl": "Daarna heeft hij geen honger meer en is hij gelukkig.",
    "en": "After that he is no longer hungry, and he is happy.",
    "image": "books/0156/04.jpg"
   },
   {
    "nl": "Totdat hij weer honger krijgt.",
    "en": "Until he gets hungry again.",
    "image": "books/0156/05.jpg"
   }
  ],
  "avi": "AVI M3",
  "shelf": "eerste",
  "colour": "#4ea9e0"
 },
